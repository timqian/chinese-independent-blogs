# Copy to .env and adjust. Real environment variables take precedence over
# this file (server.js loads it on startup only if the file exists).

# Public URL of the site. Used for canonical links, the sitemap, RSS, the
# GitHub OAuth callback and redirects; set it to your domain in production.
SITE_URL=http://localhost:8787

# Where the HTTP server listens
HOST=0.0.0.0
PORT=8787

# SQLite database file (created automatically, migrations run on startup)
DB_PATH=./data/indi.db

# Seconds rendered pages stay in the in-memory cache (0 disables; use 0 while
# developing)
CACHE_TTL=0

# Blog list fetched on every crawl, so merged PRs apply without a redeploy.
# Empty uses the bundled blogs-original.csv. `BLOGS_CSV_PATH` can point that
# fallback somewhere else.
BLOGS_CSV_URL=https://raw.githubusercontent.com/timqian/chinese-independent-blogs/master/blogs-original.csv

# Token for the admin endpoints (manual crawl etc.); generate with
# `openssl rand -hex 24` and keep it secret
ADMIN_TOKEN=

# GitHub OAuth App (callback: <SITE_URL>/auth/github/callback). Empty hides
# the GitHub login button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Login codes are sent by SMTP. Empty SMTP_HOST prints them to the log
# instead (development). SMTP_SECURE=1 for implicit TLS (port 465);
# SMTP_TLS_INSECURE=1 disables certificate checks (not recommended).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
SMTP_TLS_INSECURE=0
EMAIL_FROM=Indi <noreply@localhost>

# Set to 1 behind a trusted reverse proxy (nginx, Caddy) so email-code rate
# limits use the real client address from X-Forwarded-For
TRUST_PROXY=0

# Telegram group notifications (new blogs, weekly digest). Create a bot with
# @BotFather, add it to the group and fill both in; empty disables them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 0 to run the site without the in-process hourly crawler
CRAWL=1
